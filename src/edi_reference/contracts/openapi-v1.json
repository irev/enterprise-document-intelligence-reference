{
  "openapi": "3.1.0",
  "info": {
    "title": "tlkdoc data-plane API",
    "version": "1.0.0-design",
    "summary": "Submit documents and retrieve standardized, evidence-bound machine results. Processing is local only.",
    "description": "Design proposal (docs/RI-6.0-DATA-PLANE-API-V1.md). Specification alignment pending. Results are machine claims that always require review; they are never business approval or authorization."
  },
  "servers": [{"url": "https://{host}:{port}", "variables": {"host": {"default": "127.0.0.1"}, "port": {"default": "8444"}}}],
  "security": [{"apiKey": []}],
  "tags": [
    {"name": "documents"}, {"name": "results"}, {"name": "discovery"}, {"name": "service"}
  ],
  "paths": {
    "/v1/documents": {
      "post": {
        "tags": ["documents"],
        "operationId": "submitDocument",
        "summary": "Submit a document by upload or by URL",
        "description": "Upload: send the document bytes as the body with its media type. Storage reference (ADR-0001): send application/json with a STORAGE_REFERENCE source naming a storage connection of the caller's tenant, an opaque object id and the required sha256; the service fetches the object just in time through the tenant's grant broker and verifies the digest. Caller-supplied URLs are rejected with CALLER_URL_NOT_ACCEPTED. Idempotent per (application, Idempotency-Key).",
        "x-required-scope": "documents:write",
        "parameters": [
          {"$ref": "#/components/parameters/IdempotencyKey"},
          {"$ref": "#/components/parameters/CorrelationId"},
          {"name": "X-Filename", "in": "header", "schema": {"type": "string", "maxLength": 200}},
          {"name": "X-Processing-Profile", "in": "header", "schema": {"$ref": "#/components/schemas/Id"}},
          {"name": "X-External-Reference", "in": "header", "description": "key=value, repeatable up to 10 times; stored and returned, never interpreted.",
           "schema": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,50}=[^\\r\\n]{1,200}$"}}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/pdf": {"schema": {"type": "string", "contentMediaType": "application/pdf"}},
            "image/png": {"schema": {"type": "string", "contentMediaType": "image/png"}},
            "image/jpeg": {"schema": {"type": "string", "contentMediaType": "image/jpeg"}},
            "image/tiff": {"schema": {"type": "string", "contentMediaType": "image/tiff"}},
            "application/json": {"schema": {"$ref": "#/components/schemas/StorageReferenceSubmission"}}
          }
        },
        "responses": {
          "202": {"description": "Accepted for processing", "headers": {"Location": {"schema": {"type": "string"}}},
                  "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Document"}}}},
          "200": {"description": "Idempotent replay: the original submission",
                  "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Document"}}}},
          "400": {"$ref": "#/components/responses/Problem"},
          "401": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"},
          "404": {"$ref": "#/components/responses/Problem"},
          "409": {"$ref": "#/components/responses/Problem"},
          "413": {"$ref": "#/components/responses/Problem"},
          "415": {"$ref": "#/components/responses/Problem"},
          "429": {"$ref": "#/components/responses/RateLimited"}
        }
      },
      "get": {
        "tags": ["documents"],
        "operationId": "listDocuments",
        "summary": "List documents submitted by this application",
        "x-required-scope": "documents:read",
        "parameters": [
          {"name": "status", "in": "query", "schema": {"$ref": "#/components/schemas/DocumentStatus"}},
          {"name": "created_after", "in": "query", "schema": {"type": "string", "format": "date-time"}},
          {"name": "external_reference", "in": "query", "schema": {"type": "string", "maxLength": 251}},
          {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 200, "default": 50}},
          {"name": "cursor", "in": "query", "schema": {"type": "string", "maxLength": 200}}
        ],
        "responses": {
          "200": {"description": "Page of documents", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DocumentPage"}}}},
          "401": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/v1/documents/{document_id}": {
      "get": {
        "tags": ["documents"],
        "operationId": "getDocument",
        "summary": "Document status and latest result version",
        "x-required-scope": "documents:read",
        "parameters": [{"$ref": "#/components/parameters/DocumentId"}],
        "responses": {
          "200": {"description": "Document", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Document"}}}},
          "401": {"$ref": "#/components/responses/Problem"},
          "404": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/v1/documents/{document_id}/results": {
      "get": {
        "tags": ["results"],
        "operationId": "listResults",
        "summary": "Immutable result versions of a document",
        "x-required-scope": "results:read",
        "parameters": [{"$ref": "#/components/parameters/DocumentId"}],
        "responses": {
          "200": {"description": "Result versions",
                  "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["results"],
                    "properties": {"results": {"type": "array", "items": {"$ref": "#/components/schemas/ResultSummary"}}}}}}},
          "401": {"$ref": "#/components/responses/Problem"},
          "404": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/v1/documents/{document_id}/results/{version}": {
      "get": {
        "tags": ["results"],
        "operationId": "getResult",
        "summary": "One result version (tlkdoc.result/v1)",
        "x-required-scope": "results:read",
        "parameters": [
          {"$ref": "#/components/parameters/DocumentId"},
          {"name": "version", "in": "path", "required": true, "description": "Result version number, or 'latest'.",
           "schema": {"oneOf": [{"type": "integer", "minimum": 1}, {"const": "latest"}]}}
        ],
        "responses": {
          "200": {"description": "Result", "headers": {"ETag": {"schema": {"type": "string"}}},
                  "content": {"application/json": {"schema": {"$ref": "result-v1.schema.json"}}}},
          "401": {"$ref": "#/components/responses/Problem"},
          "404": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/v1/documents/{document_id}/reprocess": {
      "post": {
        "tags": ["documents"],
        "operationId": "reprocessDocument",
        "summary": "Run processing again; produces a new result version",
        "x-required-scope": "documents:write",
        "parameters": [{"$ref": "#/components/parameters/DocumentId"}, {"$ref": "#/components/parameters/IdempotencyKey"},
                       {"$ref": "#/components/parameters/CorrelationId"}],
        "requestBody": {"required": false, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false,
          "properties": {"processing_profile": {"$ref": "#/components/schemas/Id"}}}}}},
        "responses": {
          "202": {"description": "Reprocessing accepted", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Document"}}}},
          "200": {"description": "Idempotent replay", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Document"}}}},
          "400": {"$ref": "#/components/responses/Problem"},
          "404": {"$ref": "#/components/responses/Problem"},
          "409": {"$ref": "#/components/responses/Problem"},
          "429": {"$ref": "#/components/responses/RateLimited"}
        }
      }
    },
    "/v1/taxonomy": {
      "get": {
        "tags": ["discovery"],
        "operationId": "getTaxonomy",
        "summary": "Active document types (UNKNOWN is always reserved)",
        "x-required-scope": "documents:read",
        "responses": {
          "200": {"description": "Taxonomy", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Taxonomy"}}}},
          "401": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/v1/schemas/{document_type}": {
      "get": {
        "tags": ["discovery"],
        "operationId": "getFieldSchema",
        "summary": "Fields extracted for a document type",
        "x-required-scope": "documents:read",
        "parameters": [{"name": "document_type", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"}}],
        "responses": {
          "200": {"description": "Field schema", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/FieldSchema"}}}},
          "401": {"$ref": "#/components/responses/Problem"},
          "404": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/v1/health": {
      "get": {
        "tags": ["service"],
        "operationId": "health",
        "summary": "Liveness",
        "security": [],
        "responses": {"200": {"description": "Alive", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false,
          "required": ["status"], "properties": {"status": {"const": "ok"}}}}}}}
      }
    },
    "/v1/openapi.json": {
      "get": {
        "tags": ["service"],
        "operationId": "openapi",
        "summary": "This contract",
        "security": [],
        "responses": {"200": {"description": "OpenAPI document", "content": {"application/json": {"schema": {"type": "object"}}}}}
      }
    }
  },
  "webhooks": {
    "documentEvent": {
      "post": {
        "summary": "Document lifecycle event (identifiers only)",
        "description": "Verify Tlkdoc-Signature: v1 = hex(HMAC-SHA256(secret, t + '.' + raw_body)); reject t older than 300 seconds. Delivery is at-least-once; deduplicate on Tlkdoc-Delivery.",
        "parameters": [
          {"name": "Tlkdoc-Event", "in": "header", "required": true, "schema": {"$ref": "#/components/schemas/EventType"}},
          {"name": "Tlkdoc-Delivery", "in": "header", "required": true, "schema": {"$ref": "#/components/schemas/Id"}},
          {"name": "Tlkdoc-Signature", "in": "header", "required": true, "schema": {"type": "string", "pattern": "^t=[0-9]{10},v1=[0-9a-f]{64}$"}}
        ],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WebhookEvent"}}}},
        "responses": {"2XX": {"description": "Received; any other status is retried with backoff for up to 24 hours"}}
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {"type": "http", "scheme": "bearer", "bearerFormat": "tlk_<key_id>.<secret>",
                 "description": "Per-application key bound to tenant, application and scopes (documents:write, documents:read, results:read, documents:read:tenant)."}
    },
    "parameters": {
      "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true,
                         "schema": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[\\x21-\\x7E]+$"}},
      "CorrelationId": {"name": "X-Correlation-Id", "in": "header", "required": false, "schema": {"$ref": "#/components/schemas/Id"}},
      "DocumentId": {"name": "document_id", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^doc_[0-9A-Za-z]{10,40}$"}}
    },
    "responses": {
      "Problem": {"description": "Error (RFC 9457)", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
      "RateLimited": {"description": "Limit reached", "headers": {"Retry-After": {"schema": {"type": "integer", "minimum": 1}}},
                      "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}
    },
    "schemas": {
      "Id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"},
      "DocumentStatus": {"enum": ["RECEIVED", "ACCEPTED", "PROCESSING", "COMPLETED", "FAILED_SAFE", "REJECTED", "UNSUPPORTED"]},
      "EventType": {"enum": ["document.completed", "document.failed_safe", "document.rejected"]},
      "StorageReferenceSubmission": {
        "type": "object", "additionalProperties": false, "required": ["source"],
        "description": "Errors: CALLER_URL_NOT_ACCEPTED, SOURCE_METHOD_NOT_SUPPORTED, INVALID_SOURCE, INVALID_STORAGE_CONNECTION_ID, INVALID_OBJECT_ID, SHA256_REQUIRED, INVALID_VERSION_ID (400); STORAGE_CONNECTION_NOT_FOUND (404). Fetch failures after acceptance end in a FAILED_SAFE result whose failure.code is one of SOURCE_ACCESS_DENIED (also when storage refuses a freshly issued grant), SOURCE_OBJECT_MISSING, SOURCE_HOST_FORBIDDEN, SOURCE_REDIRECT_REFUSED, SOURCE_TOO_LARGE, SOURCE_CHECKSUM_MISMATCH, SOURCE_BROKER_INVALID_RESPONSE, UNSUPPORTED_MEDIA_TYPE or PROCESSING_ATTEMPTS_EXHAUSTED.",
        "properties": {
          "source": {
            "type": "object", "additionalProperties": false, "required": ["method", "storage_connection_id", "object_id", "sha256"],
            "properties": {
              "method": {"const": "STORAGE_REFERENCE"},
              "storage_connection_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
              "object_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/=+-]{1,512}$",
                            "description": "Opaque to the service; never used as a URL or a path."},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "version_id": {"type": "string", "pattern": "^[A-Za-z0-9._:=+-]{1,256}$"},
              "filename": {"type": "string", "maxLength": 200}
            }
          }
        }
      },
      "Document": {
        "type": "object", "additionalProperties": false,
        "required": ["document_id", "status", "correlation_id", "created_at", "updated_at", "latest_result_version", "links"],
        "properties": {
          "document_id": {"type": "string", "pattern": "^doc_[0-9A-Za-z]{10,40}$"},
          "status": {"$ref": "#/components/schemas/DocumentStatus"},
          "status_code": {"type": ["string", "null"], "description": "Stable reason for REJECTED or UNSUPPORTED."},
          "correlation_id": {"$ref": "#/components/schemas/Id"},
          "processing_profile": {"$ref": "#/components/schemas/Id"},
          "filename": {"type": ["string", "null"], "maxLength": 200},
          "media_type": {"type": ["string", "null"]},
          "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "external_references": {"type": "object", "additionalProperties": {"type": "string"}},
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"},
          "latest_result_version": {"type": ["integer", "null"], "minimum": 1},
          "links": {"type": "object", "additionalProperties": false, "required": ["self"],
                    "properties": {"self": {"type": "string"}, "latest_result": {"type": "string"}}}
        }
      },
      "DocumentPage": {
        "type": "object", "additionalProperties": false, "required": ["documents", "next_cursor"],
        "properties": {"documents": {"type": "array", "items": {"$ref": "#/components/schemas/Document"}},
                       "next_cursor": {"type": ["string", "null"]}}
      },
      "ResultSummary": {
        "type": "object", "additionalProperties": false,
        "required": ["result_version", "status", "document_type", "created_at"],
        "properties": {
          "result_version": {"type": "integer", "minimum": 1},
          "status": {"enum": ["COMPLETED", "FAILED_SAFE"]},
          "document_type": {"type": "string"},
          "created_at": {"type": "string", "format": "date-time"},
          "review_status": {"enum": ["NOT_REVIEWED", "IN_REVIEW", "REVIEWED"]}
        }
      },
      "Taxonomy": {
        "type": "object", "additionalProperties": false, "required": ["taxonomy_id", "version", "document_types", "unknown"],
        "properties": {
          "taxonomy_id": {"type": "string"},
          "version": {"type": "string"},
          "document_types": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"}},
          "unknown": {"const": "UNKNOWN"}
        }
      },
      "FieldSchema": {
        "type": "object", "additionalProperties": false, "required": ["document_type", "schema_id", "version", "fields"],
        "properties": {
          "document_type": {"type": "string"},
          "schema_id": {"type": "string"},
          "version": {"type": "string"},
          "fields": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "value_type"],
            "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
                           "value_type": {"enum": ["string", "date", "money", "identifier", "tax_id", "number"]},
                           "normalizer": {"type": ["object", "null"], "additionalProperties": false, "required": ["id", "version"],
                                          "properties": {"id": {"type": "string"}, "version": {"type": "string"}}}}}}
        }
      },
      "WebhookEvent": {
        "type": "object", "additionalProperties": false,
        "required": ["event", "document_id", "status", "correlation_id", "occurred_at"],
        "properties": {
          "event": {"$ref": "#/components/schemas/EventType"},
          "document_id": {"type": "string", "pattern": "^doc_[0-9A-Za-z]{10,40}$"},
          "result_version": {"type": ["integer", "null"], "minimum": 1},
          "status": {"$ref": "#/components/schemas/DocumentStatus"},
          "correlation_id": {"$ref": "#/components/schemas/Id"},
          "occurred_at": {"type": "string", "format": "date-time"}
        }
      },
      "Problem": {
        "type": "object", "required": ["type", "title", "status", "code", "request_id"],
        "properties": {
          "type": {"type": "string", "format": "uri"},
          "title": {"type": "string"},
          "status": {"type": "integer", "minimum": 400, "maximum": 599},
          "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,80}$"},
          "detail": {"type": "string"},
          "request_id": {"type": "string"}
        }
      }
    }
  }
}
